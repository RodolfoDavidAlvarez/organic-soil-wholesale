# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
CHECKOUT_ALERT_TO=developer@bettersystems.ai
CHECKOUT_ALERT_FROM=OSW Alerts <info@soilseedandwater.com>
DEVELOPER_ALERT_TO=developer@bettersystems.ai

# Email
RESEND_API_KEY=re_your_resend_api_key

# Client URL (for email links)
CLIENT_URL=http://localhost:3000

# Session Secret
SESSION_SECRET=your-session-secret-here

# School verification (myorganicsoil.com). The browser talks to the public
# upload, submit, and status routes. Quote and redeem stay on this server.
# INTERNAL_TRIGGER_SECRET must equal myorganicsoil.com INTERNAL_TRIGGER_SECRET.
# If that service only has LEAD_INGEST_SECRET, set INTERNAL_TRIGGER_SECRET here
# to that same value, or set MOS_LEAD_INGEST_SECRET to it. LEAD_INGEST_SECRET
# is the last fallback. The browser never receives any of these.
# INTERNAL_TRIGGER_SECRET=
# MOS_LEAD_INGEST_SECRET=
# SCHOOL_VERIFICATION_API_BASE=https://myorganicsoil.com
# VITE_SCHOOL_VERIFICATION_API_BASE=https://myorganicsoil.com

# Phoenix Fall Garden Giveaway (/win) — completed campaign.
# The October 3, 2026 drawing is complete. Public entries are closed in code.
# Legacy GIVEAWAY_ENTRIES_OPEN values cannot reopen this completed campaign.

# Private SSW Lead Report. Sends one report for every 30 valid giveaway entries.
# Sender: SSW Lead Report <reports@bettersystems.ai>
# GIVEAWAY_LEAD_REPORTS_ACTIVE=true
