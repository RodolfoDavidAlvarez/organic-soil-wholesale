# Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_live_your_stripe_live_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email
RESEND_API_KEY=re_your_resend_api_key

# Client URL (optional - Vercel will provide VERCEL_URL automatically)
# CLIENT_URL=https://your-domain.com

# Session Secret (generate a secure random string)
SESSION_SECRET=your-production-session-secret-here

# School verification. Set the same secret on this project and on
# myorganicsoil.com. Prefer INTERNAL_TRIGGER_SECRET on both. If the
# verification service has only LEAD_INGEST_SECRET, set INTERNAL_TRIGGER_SECRET
# or MOS_LEAD_INGEST_SECRET here to that exact value. Leave the API base unset
# to use https://myorganicsoil.com.
# INTERNAL_TRIGGER_SECRET=
# MOS_LEAD_INGEST_SECRET=
# SCHOOL_VERIFICATION_API_BASE=https://myorganicsoil.com
# VITE_SCHOOL_VERIFICATION_API_BASE=https://myorganicsoil.com
# A 503 from quote or redeem means that service is not ready.

# Phoenix Fall Garden Giveaway (/win). Entries are OPEN unless this is false.
# Do not set this in Vercel unless you need to pause entries.
# GIVEAWAY_ENTRIES_OPEN=false